{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nanocode-machines-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-21",
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "AgentSession" },
      { "name": "WALLETS", "class_name": "Wallet" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentSession", "Wallet"] }],
  "vars": {
    "MODEL_AUTH": "api_key",
    "RECOVERY_DELAY_MS": "5000",
    "EVENT_STREAM_KEEPALIVE_MS": "5000",
    "EVENT_PAGE_SIZE": "128",
    "EVENT_TAIL_BYTES": "4194304",
    "EVENT_COALESCE_MS": "100",
    "MODEL_SOCKET_LINGER_MS": "30000",
    "RUNTIME_MEMORY_BUDGET_BYTES": "67108864",
    "REMOTE_MAX_FRAME_BYTES": "1048576",
    "REMOTE_TIMEOUT_MS": "30000"
  },
  "observability": { "enabled": true }
}
